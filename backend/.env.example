# Django Secret Key
SECRET_KEY=your-django-secret-key-here
DEBUG=True

# Database Configuration (PostgreSQL)
DB_NAME=amour_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# LLM Provider: Amazon Bedrock Runtime + Mistral Large 3
LLM_PROVIDER=bedrock
AWS_REGION=us-west-2
AWS_BEARER_TOKEN_BEDROCK=your_amazon_bedrock_api_key
BEDROCK_MODEL_ID=mistral.mistral-large-3-675b-instruct
# Optional comma-separated Bedrock model IDs available in the same region.
BEDROCK_FALLBACK_MODEL_IDS=

# Optional: retain Groq as an explicitly selected provider.
# LLM_PROVIDER=groq
# GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# AWS / S3 credentials for other AWS services
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=your-s3-bucket-name
# Backward-compatible alias for an existing Bedrock API key variable.
BEDROCK_API_KEY=
