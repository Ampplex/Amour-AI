# Django Secret Key
SECRET_KEY=your-django-secret-key-here
DEBUG=True
CONSOLE_PASSWORD=replace-with-a-long-random-password

# Database Configuration (PostgreSQL)
DB_NAME=amour_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Groq / LLM Configuration
# /console LLM Usage records prompt-free request/token/latency metadata after migrations are applied.
GROQ_API_KEY=your-primary-groq-api-key
# GROQ_API_KEY_FALLBACK is tried after GROQ_API_KEY; additional GROQ_API_KEYS follow both.
# GROQ_API_KEY_FALLBACK=your-secondary-groq-key
# GROQ_API_KEYS=additional-key1,additional-key2
GROQ_CHAT_MODEL=qwen/qwen3.8-27b
RESPONSE_LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
# Tried in order only when Groq returns rate limits; both models must be enabled in AWS_REGION.
GROQ_BEDROCK_FALLBACK_MODEL_IDS=qwen.qwen3-32b-v1:0,deepseek.v3.2

# AWS Bedrock / S3 Configuration
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=your-s3-bucket-name
BEDROCK_MODEL_ID=mistral.mistral-large-2407-v1:0
BEDROCK_SMALL_MODEL_ID=meta.llama3-1-8b-instruct-v1:0
BEDROCK_API_KEY=your_bedrock_api_key_optional
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_bearer_token_optional
