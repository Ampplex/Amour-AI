# Django Secret Key
SECRET_KEY=your-django-secret-key-here
DEBUG=True

# Database Configuration (PostgreSQL)
DB_NAME=amour_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# LLM Provider (Mistral Large 4 is the default)
LLM_PROVIDER=mistral
MISTRAL_API_KEY=your_mistral_api_key
MISTRAL_MODEL=mistral-large-4
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_FALLBACK_MODELS=mistral-small-2603

# Optional Groq provider configuration
# LLM_PROVIDER=groq
# GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# AWS Bedrock / S3 Configuration
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=your-s3-bucket-name
BEDROCK_API_KEY=your_bedrock_api_key_optional
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_bearer_token_optional
